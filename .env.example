# Copier ce fichier en .env (aucun secret réel ne doit être commité)
# ---- Versions des images
HADOOP_VERSION=3.4.2
SPARK_VERSION=4.1.3
KAFKA_VERSION=4.2.2
# ---- Ressources des workers Spark (adapter à la RAM du PC)
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=1536m
# ---- Kafka / producteur
KAFKA_TOPIC=hospital-discharges
KAFKA_PARTITIONS=3
EVENTS_PER_SECOND=20
MAX_EVENTS=0
START_ROW=0
LOOP=false
# ---- Ports publiés sur l'hôte
NAMENODE_UI_PORT=9870
SPARK_MASTER_UI_PORT=8080
SPARK_WORKER1_UI_PORT=18081
SPARK_WORKER2_UI_PORT=18082
SPARK_APP_UI_PORT=4040
KAFKA_UI_PORT=8090
# ---- Restitution (livrables suivants)
POSTGRES_DB=readmission
POSTGRES_USER=readmission
POSTGRES_PASSWORD=change_me
